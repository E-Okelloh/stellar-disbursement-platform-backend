{
  "installCommand": "yarn install",
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "framework": null,
  "routes": [
    { "src": "/app/static/(.*)", "dest": "/static/$1" },
    { "src": "/app/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/app/(.+\\.[a-z]+)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
